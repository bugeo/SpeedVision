<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:TrafficSpeedAnalyzer.Desktop.Controls">
    <!--
        Stili di SpeedVision per Avalonia: gli stessi dell'app per Windows (AppStyles.xaml), con le classi al posto
        degli stili con nome. In WPF: Style="{StaticResource Caption}"; qui: Classes="caption".
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackground}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ───── Testi ───── -->
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.stepTitle">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <!-- ───── Contenitori ───── -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Riquadro della guida: cornice verde di 3 px quando è il prossimo su cui agire -->
    <Style Selector="Border.card.active">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <!-- Visore del video: cornice normale; verde di 3 px quando il prossimo passo si fa sul video -->
    <Style Selector="Border.viewer">
        <Setter Property="Background" Value="#FF0A0D12" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.viewer.active">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Border.notice">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.notice.error">
        <Setter Property="Background" Value="#1FFF6B6B" />
        <Setter Property="BorderBrush" Value="#55FF6B6B" />
    </Style>
    <Style Selector="Border.notice.warning">
        <Setter Property="Background" Value="#1FFFB547" />
        <Setter Property="BorderBrush" Value="#55FFB547" />
    </Style>
    <Style Selector="Border.notice.success">
        <Setter Property="Background" Value="#1F5EE09A" />
        <Setter Property="BorderBrush" Value="#555EE09A" />
    </Style>
    <Style Selector="Border.notice.info">
        <Setter Property="Background" Value="#142FCB79" />
        <Setter Property="BorderBrush" Value="#442FCB79" />
    </Style>

    <!-- Avviso in alto (InfoBar di WPF-UI) -->
    <Style Selector="Border.infoBar">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10,8,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#1A4CC2FF" />
        <Setter Property="BorderBrush" Value="#444CC2FF" />
    </Style>
    <Style Selector="Border.infoBar.success">
        <Setter Property="Background" Value="#1F5EE09A" />
        <Setter Property="BorderBrush" Value="#555EE09A" />
    </Style>
    <Style Selector="Border.infoBar.warning">
        <Setter Property="Background" Value="#1FFFB547" />
        <Setter Property="BorderBrush" Value="#55FFB547" />
    </Style>
    <Style Selector="Border.infoBar.error">
        <Setter Property="Background" Value="#26FF6B6B" />
        <Setter Property="BorderBrush" Value="#66FF6B6B" />
    </Style>

    <!-- Numero (icona) tondo del passo -->
    <Style Selector="Border.stepNumber">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ───── Pulsanti (UiButton) ───── -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Primary: l'unica azione da fare ora, in verde -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FF0B0E14" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter, Button.success /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="#FF0B0E14" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF4DDB8F" />
        <Setter Property="BorderBrush" Value="#FF4DDB8F" />
        <Setter Property="Foreground" Value="#FF0B0E14" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF1FA85F" />
        <Setter Property="Foreground" Value="#FF0B0E14" />
    </Style>
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FF0B0E14" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF4DDB8F" />
        <Setter Property="Foreground" Value="#FF0B0E14" />
    </Style>
    <Style Selector="Button.transparent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.transparent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#18FFFFFF" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#FFC42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFD83B2B" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.transparent:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Logo nella barra in alto: pulsante senza cornice -->
    <Style Selector="Button.logo">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.logo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#22FFFFFF" />
    </Style>

    <!-- ───── Barra dei passi (in alto) ───── -->
    <Style Selector="RadioButton.step">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="GroupName" Value="Steps" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="Bg" CornerRadius="8" Background="Transparent" Padding="12,8,16,8" Margin="0,4">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                    <Border Name="Bar" Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="12,0"
                            Background="{StaticResource AccentBrush}" IsVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.step:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="{StaticResource HoverBackground}" />
    </Style>
    <!-- Passo completato: la sottolineatura verde resta -->
    <Style Selector="RadioButton.step.done /template/ Border#Bar">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.step:checked /template/ Border#Bg">
        <Setter Property="Background" Value="{StaticResource SelectedBackground}" />
    </Style>
    <Style Selector="RadioButton.step:checked /template/ Border#Bar">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.step:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Frecce per ordinare i risultati: quella scelta nel colore della linea A (il verde resta alla guida) -->
    <Style Selector="RadioButton.sort">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="GroupName" Value="PassageSort" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" CornerRadius="5" Padding="5,3" Background="Transparent"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.sort:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="RadioButton.sort:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="{StaticResource HoverBackground}" />
    </Style>
    <Style Selector="RadioButton.sort:checked">
        <Setter Property="Foreground" Value="{StaticResource LineABrush}" />
    </Style>
    <Style Selector="RadioButton.sort:checked /template/ Border#Bg">
        <Setter Property="Background" Value="{StaticResource SelectedBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineABrush}" />
    </Style>
    <Style Selector="RadioButton.sort PathIcon">
        <Setter Property="Foreground" Value="{Binding $parent[RadioButton].Foreground}" />
    </Style>

    <!-- ───── Riquadri richiudibili (CardExpander di WPF-UI) ───── -->
    <Style Selector="Expander.card">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    </Style>
    <Style Selector="Expander.card /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    </Style>

    <!-- ───── Risultati ───── -->
    <Style Selector="ListBox.results">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.resultCard">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.resultCard">
        <Setter Property="Background" Value="{StaticResource SelectedBackground}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.resultCard">
        <Setter Property="Background" Value="{StaticResource SelectedBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <!-- Oltre il limite di velocità: bordo rosso, anche quando la riga è selezionata -->
    <Style Selector="Border.resultCard.overLimit">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.resultCard.overLimit">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="WrapPanel.rowActions c|UiButton">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Istogramma: fasce sopra il limite in rosso -->
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="2,2,0,0" />
    </Style>
    <Style Selector="Border.bar.over">
        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
    </Style>

    <!-- Anello di attesa (ProgressRing di WPF-UI) -->
    <Style Selector="Arc.spinner">
        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="270" />
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox PathIcon.inner">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
</Styles>
