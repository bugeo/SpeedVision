<ui:FluentWindow x:Class="TrafficSpeedAnalyzer.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:TrafficSpeedAnalyzer.App.Localization"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:TrafficSpeedAnalyzer.App.ViewModels;assembly=TrafficSpeedAnalyzer.Presentation"
                 xmlns:controls="clr-namespace:TrafficSpeedAnalyzer.App.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="SpeedVision"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1480" Height="920" MinWidth="1180" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="">
            <ui:TitleBar.Header>
                <!-- Logo: apre il sito -->
                <Button Command="{Binding OpenWebsiteCommand}" Cursor="Hand" Padding="4,2" Margin="8,0,0,0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Focusable="False"
                        ToolTip="{loc:Tr 'Apri il sito di SpeedVision'}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Image Source="/Assets/speedvision-logo.png" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══════════ Barra dei passi (in alto) ═══════════ -->
            <Border Grid.Row="0" Background="{StaticResource RailBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                    Padding="12,4,16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource StepRadioH}"
                                     Tag="{Binding IsVideoStepDone}"
                                     IsChecked="{Binding SelectedStep, Converter={StaticResource EnumEquals}, ConverterParameter=Video}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepNumber}">
                                    <ui:SymbolIcon Symbol="Video24" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Video'}" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource StepRadioH}" IsEnabled="{Binding HasVideo}"
                                     Tag="{Binding IsRoadStepDone}"
                                     IsChecked="{Binding SelectedStep, Converter={StaticResource EnumEquals}, ConverterParameter=Road}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepNumber}">
                                    <ui:SymbolIcon Symbol="Map24" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Strada'}" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource StepRadioH}" IsEnabled="{Binding HasVideo}"
                                     Tag="{Binding IsAnalysisStepDone}"
                                     IsChecked="{Binding SelectedStep, Converter={StaticResource EnumEquals}, ConverterParameter=Analysis}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepNumber}">
                                    <ui:SymbolIcon Symbol="VehicleCar24" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Analisi veicoli'}" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource StepRadioH}" IsEnabled="{Binding HasVideo}"
                                     Tag="{Binding IsCalibrationStepDone}"
                                     IsChecked="{Binding SelectedStep, Converter={StaticResource EnumEquals}, ConverterParameter=Calibration}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepNumber}">
                                    <ui:SymbolIcon Symbol="Ruler24" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Calibrazione'}" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource StepRadioH}" IsEnabled="{Binding HasVideo}"
                                     Tag="{Binding IsResultsStepDone}"
                                     IsChecked="{Binding SelectedStep, Converter={StaticResource EnumEquals}, ConverterParameter=Results}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepNumber}">
                                    <ui:SymbolIcon Symbol="Table24" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" FontSize="16">
                                        <Run Text="{loc:Tr 'Risultati'}" />
                                        <Run Text="{Binding Passages.Count, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{StaticResource TextSecondary}" FontWeight="Normal" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- A destra: impostazioni (lingua e registro) in una finestra a parte -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{loc:Tr 'Impostazioni'}" Icon="{ui:SymbolIcon Settings24}" Appearance="Transparent"
                                   Padding="10,6" VerticalAlignment="Center" Click="OnSettingsClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="392" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- ═══════════ Area centrale: video ═══════════ -->
            <Grid Grid.Column="1" Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Intestazione -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VideoTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding ResolutionText}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding FpsText}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimary}">
                                    <Run Text="{loc:Tr 'Durata'}" Foreground="{StaticResource TextSecondary}" />
                                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimary}">
                                    <Run Text="{loc:Tr 'Dimensione'}" Foreground="{StaticResource TextSecondary}" />
                                    <Run Text="{Binding FileSizeText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimary}">
                                    <Run Text="{loc:Tr 'Codifica'}" Foreground="{StaticResource TextSecondary}" />
                                    <Run Text="{Binding CodecText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding IsStabilized, Converter={StaticResource BoolToVisibility}}"
                                    Background="#1F5EE09A" BorderBrush="#555EE09A">
                                <TextBlock Text="{loc:Tr 'Stabilizzato'}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding HasClockTime, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimary}">
                                    <Run Text="{loc:Tr 'Inizio'}" Foreground="{StaticResource TextSecondary}" />
                                    <Run Text="{Binding RecordingStartText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <!-- Verde solo finché non c'è un video: dopo non è più l'azione da fare -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Video di prova su GitHub, per chi vuole provare il programma -->
                    <ui:Button Content="{loc:Tr 'Scarica video di esempio'}" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Command="{Binding OpenSamplesCommand}" Padding="16,8" Margin="0,0,8,0" VerticalAlignment="Top"
                               ToolTip="{loc:Tr 'Apre i video di prova su GitHub'}" />
                    <ui:Button Content="{loc:Tr 'Apri video'}" Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding OpenVideoCommand}" IsEnabled="{Binding IsReady}" Padding="16,8" VerticalAlignment="Top">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Primary" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                        <Setter Property="Appearance" Value="Secondary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Messaggi -->
                <ui:InfoBar Grid.Row="1" Margin="0,0,0,12"
                            Title="{Binding StatusTitle}" Message="{Binding StatusMessage}"
                            Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}}" IsOpen="{Binding IsStatusOpen, Mode=TwoWay}" IsClosable="True" />

                <!-- Visore: cornice verde quando il prossimo passo si fa sul video (bordi della strada, linee tra le corsie) -->
                <Border Grid.Row="2" Style="{StaticResource Viewer}" Tag="{Binding IsVideoStepActive}" ClipToBounds="True">
                    <Grid>
                        <controls:VideoViewport x:Name="Viewport"
                                                Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}"
                                                Source="{Binding CurrentFrame}"
                                                VideoWidth="{Binding VideoWidth}"
                                                VideoHeight="{Binding VideoHeight}"
                                                LineA="{Binding LineA}"
                                                LineB="{Binding LineB}"
                                                Points="{Binding OverlayPoints}"
                                                Markers="{Binding CrossingMarkers}"
                                                Mode="{Binding ViewportMode}"
                                                EditLines="{Binding SelectedStep, Converter={StaticResource EnumEquals}, ConverterParameter=Calibration}"
                                                LineEditedCommand="{Binding LineEditedCommand}"
                                                PointPlacedCommand="{Binding PlacePointCommand}"
                                                ReferencePlacedCommand="{Binding ReferencePlacedCommand}"
                                                RefPointA="{Binding ShownRefPointA}"
                                                RefPointB="{Binding ShownRefPointB}"
                                                VanishingPoint="{Binding ShownVanishingPoint}"
                                                Boxes="{Binding OverlayBoxes}"
                                                Region="{Binding AnalysisRegionBox}"
                                                ShowRegion="{Binding ShowAnalysisRegion}"
                                                Road="{Binding Road}"
                                                EditRoad="{Binding SelectedStep, Converter={StaticResource EnumEquals}, ConverterParameter=Road}"
                                                EditRoadDividers="{Binding RoadEdgesConfirmed}"
                                                RoadEditedCommand="{Binding RoadEditedCommand}" />

                        <!-- Nessun video -->
                        <Border x:Name="DropZone" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                                Margin="28" CornerRadius="12" BorderThickness="2" BorderBrush="#33FFFFFF" Background="#06FFFFFF">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                                <ui:SymbolIcon Symbol="VideoClip24" FontSize="56" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr 'Trascina qui un video di traffico'}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,6"
                                           HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" FontSize="13"
                                           Text="{loc:Tr 'MP4, MOV, MKV, AVI… Il video resta sul tuo PC.'}" />
                                <ui:Button Content="{loc:Tr 'Scegli un file…'}" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding OpenVideoCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="18,9" />
                                <!-- Offri un caffè (Buy Me a Coffee): stesso aspetto di «Scegli un file…», più distanziato -->
                                <ui:Button Content="{loc:Tr 'Supporta lo sviluppo di questa applicazione'}" Appearance="Secondary" Icon="{ui:SymbolIcon DrinkCoffee24}"
                                           Command="{Binding OpenSupportCommand}" HorizontalAlignment="Center" Margin="0,50,0,0" Padding="18,9"
                                           ToolTip="buymeacoffee.com/bugeo" />
                            </StackPanel>
                        </Border>

                        <!-- FFmpeg mancante -->
                        <Border Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BoolToVisibility}}" Background="#F00A0D12">
                            <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="24" Foreground="{StaticResource WarnBrush}" />
                                        <TextBlock Text="{loc:Tr 'Serve FFmpeg per leggere i video'}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                                               Text="{loc:Tr 'Manca la cartella «ffmpeg» accanto a SpeedVision.exe. Estrai di nuovo lo zip completo, oppure installa FFmpeg con questo comando in PowerShell e premi «Riprova».'}" />
                                    <Border Background="#22000000" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FfmpegInstallCommand}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="1" Content="{loc:Tr 'Copia'}" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyInstallCommandCommand}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="{loc:Tr 'Riprova'}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RetryFfmpegCommand}" Margin="0,0,8,0" />
                                        <ui:Button Content="{loc:Tr 'Indica dove si trova ffmpeg.exe…'}" Command="{Binding ChooseFfmpegCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Operazione in corso -->
                        <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Background="#C00A0D12">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding BusyText}" Margin="0,16,0,0" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Barra di navigazione -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,12,0,0"
                        IsEnabled="{Binding HasVideo}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Icon="{ui:SymbolIcon Previous24}" Appearance="Transparent" Command="{Binding GoToStartCommand}" ToolTip="{loc:Tr 'Inizio (Home)'}" Padding="8" />
                            <ui:Button Content="−10" Appearance="Transparent" Command="{Binding StepFramesCommand}" CommandParameter="-10" ToolTip="{loc:Tr 'Indietro di 10 fotogrammi (Maiusc+←)'}" Padding="8" MinWidth="44" />
                            <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Command="{Binding StepFramesCommand}" CommandParameter="-1" ToolTip="{loc:Tr 'Fotogramma precedente (←)'}" Padding="8" />
                            <Grid Margin="4,0">
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Play24}" Command="{Binding TogglePlayCommand}" ToolTip="{loc:Tr 'Riproduci (Spazio)'}" Padding="12,8"
                                           Visibility="{Binding IsPlaying, Converter={StaticResource TruthyToVisibility}, ConverterParameter=Invert}" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Pause24}" Command="{Binding TogglePlayCommand}" ToolTip="{loc:Tr 'Pausa (Spazio)'}" Padding="12,8"
                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Command="{Binding StepFramesCommand}" CommandParameter="1" ToolTip="{loc:Tr 'Fotogramma successivo (→)'}" Padding="8" />
                            <ui:Button Content="+10" Appearance="Transparent" Command="{Binding StepFramesCommand}" CommandParameter="10" ToolTip="{loc:Tr 'Avanti di 10 fotogrammi (Maiusc+→)'}" Padding="8" MinWidth="44" />
                            <ui:Button Icon="{ui:SymbolIcon Next24}" Appearance="Transparent" Command="{Binding GoToEndCommand}" ToolTip="{loc:Tr 'Fine (Fine)'}" Padding="8" />
                        </StackPanel>

                        <Slider Grid.Column="1" Margin="14,0" VerticalAlignment="Center" IsEnabled="{Binding IsNotAnalyzing}"
                                Minimum="0" Maximum="{Binding SliderMaximum}" Value="{Binding SliderPosition, Mode=TwoWay}"
                                IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" Focusable="False" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="170">
                            <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="18" Foreground="{StaticResource TextPrimary}">
                                <Run Text="{Binding CurrentTimeText, Mode=OneWay}" />
                                <Run Text="{Binding CurrentClockText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding FrameCounterText}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════ Pannello del passo ═══════════ -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,18">
                    <Grid>
                        <!-- Passo 1: video -->
                        <StackPanel Visibility="{Binding SelectedStep, Converter={StaticResource EnumToVisibility}, ConverterParameter=Video}">
                            <TextBlock Text="{loc:Tr 'Video'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,-6,0,14" Text="{loc:Tr 'Trascina il video a destra o premi «Apri video».'}"
                                       Visibility="{Binding HasVideo, Converter={StaticResource TruthyToVisibility}, ConverterParameter=Invert}" />

                            <!-- Stabilizzazione: primo passo dopo l'apertura -->
                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsStabilizationStepActive}"
                                    Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Stabilizzazione'}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                               Text="{loc:Tr 'Serve se l\'immagine trema (vento, mezzi pesanti): le linee restano sui riferimenti a terra.'}" />

                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10"
                                               Visibility="{Binding IsStabilizationUnsupported, Converter={StaticResource BoolToVisibility}}"
                                               Text="{loc:Tr 'Questo FFmpeg non può stabilizzare. Installa la versione completa: winget install --id Gyan.FFmpeg -e'}" />

                                    <TextBlock Style="{StaticResource Body}" Text="{loc:Tr 'Vuoi stabilizzare il video?'}" FontWeight="SemiBold" Margin="0,0,0,8"
                                               Visibility="{Binding IsStabilizationStepActive, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Visibility="{Binding ShowStabilizeButton, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Icon="{ui:SymbolIcon VideoClip24}" HorizontalAlignment="Stretch" Padding="12,9"
                                                   Command="{Binding StabilizeCommand}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Content" Value="{loc:Tr 'Stabilizza video'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStabilizationStepActive}" Value="True">
                                                            <Setter Property="Content" Value="{loc:Tr 'Sì, stabilizza'}" />
                                                            <Setter Property="Appearance" Value="Primary" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Grid.Column="1" Content="{loc:Tr 'No, non serve'}" Margin="8,0,0,0" Padding="12,9"
                                                   Command="{Binding SkipStabilizationCommand}"
                                                   Visibility="{Binding IsStabilizationStepActive, Converter={StaticResource BoolToVisibility}}">
                                                   <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStabilizationStepActive}" Value="True">
                                                            <Setter Property="Appearance" Value="Primary" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </Grid>

                                    <!-- In corso -->
                                    <StackPanel Visibility="{Binding IsStabilizing, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding StabilizationStepText}" />
                                        <ProgressBar Margin="0,8,0,6" Height="6" Maximum="100" Value="{Binding StabilizationProgressValue}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StabilizationEtaText}" Margin="0,0,0,8" />
                                        <ui:Button Content="{loc:Tr 'Annulla'}" Appearance="Danger" Icon="{ui:SymbolIcon Stop24}" HorizontalAlignment="Stretch" Padding="12,8"
                                                   Command="{Binding CancelStabilizationCommand}" />
                                    </StackPanel>

                                    <!-- Esito -->
                                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="{Binding StabilizationSummary}"
                                               Visibility="{Binding StabilizationSummary, Converter={StaticResource TruthyToVisibility}}" />
                                    <Border Style="{StaticResource Notice}" Background="#1FFFB547" BorderBrush="#55FFB547" Margin="0,10,0,0"
                                            Visibility="{Binding StabilizationWarning, Converter={StaticResource TruthyToVisibility}}">
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding StabilizationWarning}" />
                                    </Border>
                                    <Grid Margin="0,10,0,0" Visibility="{Binding IsStabilized, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Content="{loc:Tr 'Usa l\'originale'}" Icon="{ui:SymbolIcon ArrowUndo24}" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                                   Command="{Binding UseOriginalVideoCommand}" ToolTip="{loc:Tr 'Torna al video originale non stabilizzato'}" />
                                        <ui:Button Grid.Column="1" Content="{loc:Tr 'Salva copia…'}" Icon="{ui:SymbolIcon Save24}" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                                   Command="{Binding SaveStabilizedCopyCommand}" ToolTip="{loc:Tr 'Salva il video stabilizzato in una cartella a tua scelta'}" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0" Visibility="{Binding StabilizationCacheText, Converter={StaticResource TruthyToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding StabilizationCacheText}" TextWrapping="Wrap" />
                                        <ui:Button Grid.Column="1" Content="{loc:Tr 'Libera'}" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Padding="8,4" Margin="8,0,0,0"
                                                   Command="{Binding ClearStabilizationCacheCommand}" ToolTip="{loc:Tr 'Elimina i video stabilizzati salvati (tranne quello in uso)'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsRecordingStepActive}"
                                    Visibility="{Binding ShowRecordingStartCard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Inizio della registrazione'}" />
                                    <!-- Maschera: si scrivono solo le cifre, i separatori sono già al loro posto -->
                                    <ui:TextBox Text="{Binding RecordingStartText, UpdateSourceTrigger=PropertyChanged}"
                                                controls:MaskedInput.Mask="00/00/0000 00:00:00"
                                                FontFamily="Consolas" FontSize="16" Icon="{ui:SymbolIcon Clock24}" ClearButtonEnabled="False" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="4,4,0,0" FontFamily="Consolas"
                                               Text="{loc:Tr 'gg/mm/aaaa hh:mm:ss'}" />
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"
                                               Text="{Binding RecordingStartError}" Visibility="{Binding RecordingStartError, Converter={StaticResource TruthyToVisibility}}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding RecordingStartSourceText}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="{loc:Tr 'Serve per gli orari reali nelle esportazioni.'}" />
                                    <!-- Sempre visibili: tornando a questo passo si può cambiare la data e salvarla -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Un solo pulsante verde: «Conferma» se la data è stata letta dal video (o scritta), altrimenti «Prosegui senza data» -->
                                        <ui:Button Content="{loc:Tr 'Conferma la data'}" Icon="{ui:SymbolIcon Checkmark24}" HorizontalAlignment="Stretch" Margin="0,0,4,0" Padding="12,9"
                                                   Command="{Binding ConfirmRecordingStartCommand}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasClockTime}" Value="True" />
                                                                <Condition Binding="{Binding IsRecordingStepActive}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Appearance" Value="Primary" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Grid.Column="1" Content="{loc:Tr 'Prosegui senza data'}" HorizontalAlignment="Stretch" Margin="4,0,0,0" Padding="12,9"
                                                   Command="{Binding SkipRecordingStartCommand}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Appearance" Value="Primary" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasClockTime}" Value="True">
                                                            <Setter Property="Appearance" Value="Secondary" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecordingStepActive}" Value="False">
                                                            <Setter Property="Appearance" Value="Secondary" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Passo 4: calibrazione (dopo l'analisi: si può cambiare senza rifarla) -->
                        <StackPanel Visibility="{Binding SelectedStep, Converter={StaticResource EnumToVisibility}, ConverterParameter=Calibration}">
                            <TextBlock Text="{loc:Tr 'Calibrazione'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextPrimary}" />

                            <!-- Calibrazione salvata: in cima, per riusarla subito con un altro video dalla stessa posizione -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:Button Content="{loc:Tr 'Salva'}" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCalibrationCommand}" Margin="0,0,8,0"
                                           ToolTip="{loc:Tr 'Salva la calibrazione per riusarla con altri video dalla stessa posizione'}" />
                                <ui:Button Content="{loc:Tr 'Carica…'}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding LoadCalibrationCommand}" />
                            </StackPanel>
                            
                            <!-- Metodo di calibrazione: primo passo, nessuna scelta preselezionata -->
                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsMethodStepActive}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Come calibrare'}" />
                                    <RadioButton GroupName="DistanceMode" Content="{loc:Tr 'Con due riferimenti misurati sul campo'}" IsChecked="{Binding IsDistanceKnownMode}" Margin="0,0,0,6" />
                                    <RadioButton GroupName="DistanceMode" Content="{loc:Tr 'Con due riferimenti a terra e punto di fuga'}" IsChecked="{Binding IsVanishingMode}" Margin="0,0,0,6" />
                                    <RadioButton GroupName="DistanceMode" Content="{loc:Tr 'Con un\'auto che riconosco'}" IsChecked="{Binding EstimateDistanceFromVehicle}" />
                                    <!-- Giudizio automatico sulla ripresa: solo informativo, non impedisce la scelta -->
                                    <!-- <TextBlock Style="{StaticResource Caption}" Text="{Binding VehicleMethodNote}" Margin="28,4,0,0"
                                               Visibility="{Binding VehicleMethodNote, Converter={StaticResource TruthyToVisibility}}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding CalibrationEstimateText}" Margin="0,10,0,0"
                                               Visibility="{Binding EstimateDistanceFromVehicle, Converter={StaticResource BoolToVisibility}}" />
                                            -->
                                 </StackPanel>
                            </Border>

                            <!-- Calibrazione con due riferimenti a terra e punto di fuga: A, B, poi il punto di fuga -->
                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsVanishingStepActive}"
                                    Visibility="{Binding ShowVanishingCard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Riferimenti a terra e punto di fuga'}" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding VanishingHint}" Margin="0,0,0,10" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="12" Height="12" Fill="{StaticResource LineABrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Tr 'Riferimento A'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Width="130" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RefPointAStatus}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="12" Height="12" Fill="{StaticResource LineBBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Tr 'Riferimento B'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Width="130" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RefPointBStatus}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="12" Height="12" Fill="#FFFFB547" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Tr 'Punto di fuga'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Width="130" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding VanishingPointStatus}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ui:Button Content="{loc:Tr 'Rimetti i punti'}" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Transparent" HorizontalAlignment="Left" Margin="0,4,0,0"
                                               Command="{Binding ResetVanishingPointsCommand}"
                                               Visibility="{Binding HasVanishingPoints, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- Calibrazione con le auto: «Che auto è?» (prima la corsia più vicina, poi la più lontana) -->
                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsReferenceStepActive}"
                                    Visibility="{Binding ShowDistanceEstimatePanel, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding DistanceEstimateTitle}" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DistanceEstimateHint}" Margin="0,0,0,10" />

                                    <!-- Auto confermate: una per riquadro, ognuna modificabile -->
                                    <Border Background="#14FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,8"
                                            Visibility="{Binding ShowFirstCarBox, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FirstCarTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding FirstCarDetail}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="{loc:Tr 'Modifica'}" Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Padding="10,5" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Command="{Binding EditFirstCarCommand}" />
                                        </Grid>
                                    </Border>
                                    <Border Background="#14FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,8"
                                            Visibility="{Binding ShowSecondCarBox, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SecondCarTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding SecondCarDetail}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="{loc:Tr 'Modifica'}" Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Padding="10,5" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Command="{Binding EditSecondCarCommand}" />
                                        </Grid>
                                    </Border>

                                    <!-- Scelta del modello dell'auto mostrata -->
                                    <StackPanel Visibility="{Binding IsPickingVehicle, Converter={StaticResource BoolToVisibility}}">
                                        <ui:TextBox Text="{Binding VehicleSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'Cerca marca o modello'}"
                                                    Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,6" />
                                        <ListBox ItemsSource="{Binding FilteredReferenceVehicles}" SelectedItem="{Binding SelectedReferenceVehicle}"
                                                 Height="200" Background="#10FFFFFF" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Content="{loc:Tr 'È questa'}" FontWeight="Bold" HorizontalAlignment="Stretch" Padding="12,8"
                                                       Command="{Binding UseReferenceVehicleCommand}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Appearance" Value="Primary" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasValidManualLength}" Value="True">
                                                                <Setter Property="Appearance" Value="Secondary" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button Grid.Column="1" Content="{loc:Tr 'Non lo so'}" Margin="8,0,0,0" Padding="12,8"
                                                       Command="{Binding SkipReferenceVehicleCommand}" ToolTip="{loc:Tr 'Passa all\'auto successiva'}" />
                                        </Grid>
                                        <!-- Lunghezza inserita a mano, se il modello non è nell'elenco -->
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,4"
                                                   Text="{loc:Tr 'Oppure scrivi la lunghezza dell\'auto:'}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding ManualLengthText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="4,25" ClearButtonEnabled="False" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="{loc:Tr 'metri'}" Margin="8,0,8,0" VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="2" Content="{loc:Tr 'Usa questa lunghezza'}" HorizontalAlignment="Stretch" Padding="10,7"
                                                       Command="{Binding UseManualLengthCommand}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Appearance" Value="Secondary" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasValidManualLength}" Value="True">
                                                                <Setter Property="Appearance" Value="Primary" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                                                   Text="{Binding ManualLengthError}" Visibility="{Binding ManualLengthError, Converter={StaticResource TruthyToVisibility}}" />
                                        <!-- Modifica di un'auto già confermata: si può annullare -->
                                        <ui:Button Content="{loc:Tr 'Annulla la modifica'}" Appearance="Transparent" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                                   Command="{Binding CancelCarEditCommand}"
                                                   Visibility="{Binding ShowCancelCarEdit, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- Seconda auto (corsia più lontana): si può saltare -->
                                        <ui:Button Content="{loc:Tr 'Salta: va bene così'}" Appearance="Transparent" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                                   Command="{Binding SkipSecondReferenceCommand}"
                                                   Visibility="{Binding ShowSkipSecond, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- Nessuna analisi: prima vanno tracciate le auto -->
                                    <ui:Button Content="{loc:Tr 'Vai all\'analisi'}" Appearance="Primary" Icon="{ui:SymbolIcon VehicleCar24}" HorizontalAlignment="Stretch" Padding="12,8"
                                               Command="{Binding GoToStepCommand}" CommandParameter="Analysis"
                                               Visibility="{Binding ShowGoToAnalysis, Converter={StaticResource BoolToVisibility}}" />


                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" Text="{Binding DistanceEstimateWarning}" Margin="0,8,0,0"
                                               Visibility="{Binding DistanceEstimateWarning, Converter={StaticResource TruthyToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsLinesStepActive}"
                                    Visibility="{Binding ShowLinesCard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Linee di rilevamento'}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource LineABrush}" VerticalAlignment="Center">
                                            <TextBlock Text="A" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Tr 'Linea A'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding LineAStatus}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="{loc:Tr 'Disegna'}" Icon="{ui:SymbolIcon Edit24}" Command="{Binding DrawLineACommand}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource LineBBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="B" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Tr 'Linea B'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding LineBStatus}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="{loc:Tr 'Disegna'}" Icon="{ui:SymbolIcon Edit24}" Command="{Binding DrawLineBCommand}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                               Text="{loc:Tr 'Trascina gli estremi per correggere. Rotellina: zoom · tasto destro: sposta la vista.'}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="{loc:Tr 'Scambia A e B'}" Icon="{ui:SymbolIcon ArrowSwap24}" Command="{Binding SwapLinesCommand}" Margin="0,0,8,0" />
                                        <ui:Button Content="{loc:Tr 'Ricomincia'}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearLinesCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsDistanceStepActive}"
                                    Visibility="{Binding ShowDistanceCard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Distanza tra le linee'}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="DistanceBox" Text="{Binding DistanceText, UpdateSourceTrigger=PropertyChanged}"
                                                    FontSize="16" Icon="{ui:SymbolIcon Ruler24}" />
                                        <TextBlock Grid.Column="1" Text="{loc:Tr 'metri'}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="{Binding DistanceCardHint}"
                                               Visibility="{Binding DistanceCardHint, Converter={StaticResource TruthyToVisibility}}" />
                                    <!-- In alternativa al metro: i due punti si cercano sulla mappa e la distanza torna qui -->
                                    <ui:Button Content="{loc:Tr 'Rileva su mappa'}" Icon="{ui:SymbolIcon Map24}" Appearance="Transparent"
                                               HorizontalAlignment="Left" Margin="0,4,0,0"
                                               Command="{Binding OpenMapCommand}"
                                               ToolTip="{loc:Tr 'Clicca sulla mappa dove le linee A e B incontrano lo stesso bordo della strada'}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding MapResultText}" Margin="0,8,0,0"
                                               Visibility="{Binding MapResultText, Converter={StaticResource TruthyToVisibility}}" />
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" Text="{Binding MapWarning}" Margin="0,6,0,0"
                                               Visibility="{Binding MapWarning, Converter={StaticResource TruthyToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- Problemi e avvisi -->
                            <ItemsControl ItemsSource="{Binding CalibrationErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Notice}" Background="#1FFF6B6B" BorderBrush="#55FF6B6B">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="16" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="8,0,0,0" MaxWidth="300" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CalibrationWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Notice}" Background="#1FFFB547" BorderBrush="#55FFB547">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="8,0,0,0" MaxWidth="300" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Notice}" Background="#1F5EE09A" BorderBrush="#555EE09A"
                                    Visibility="{Binding IsCalibrationValid, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="{StaticResource OkBrush}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding CalibrationSummary}" Style="{StaticResource Body}" Margin="8,0,0,0" MaxWidth="300" />
                                </StackPanel>
                            </Border>

                            <ui:Button Content="{loc:Tr 'Procedi &gt;&gt;'}" Appearance="Primary" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Stretch" Padding="12,11" Margin="0,2,0,14"
                                       Command="{Binding GoToStepCommand}" CommandParameter="Results"
                                       IsEnabled="{Binding CanLeaveCalibration}" />
                        </StackPanel>

                        <!-- Passo 2: strada (bordi e corsie) -->
                        <StackPanel Visibility="{Binding SelectedStep, Converter={StaticResource EnumToVisibility}, ConverterParameter=Road}">
                            <TextBlock Text="{loc:Tr 'Strada'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                       Text="{loc:Tr 'L\'analisi considera solo i veicoli sulla strada e ne riconosce la corsia.'}" />

                            <!-- 1. Bordi della strada -->
                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsRoadAreaStepActive}"
                                    Visibility="{Binding ShowRoadAreaCard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Bordi della strada'}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                               Text="{loc:Tr 'Porta i quattro pallini sugli angoli della carreggiata.'}" />
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding RoadCornersHint}"
                                               Visibility="{Binding IsRoadAreaStepActive, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Content="{loc:Tr 'I bordi sono a posto'}" Icon="{ui:SymbolIcon Checkmark24}" HorizontalAlignment="Stretch" Padding="12,9"
                                               Command="{Binding ConfirmRoadEdgesCommand}"
                                               Visibility="{Binding ShowConfirmRoadEdges, Converter={StaticResource BoolToVisibility}}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <!-- 2. Quante corsie (dopo i bordi) -->
                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsRoadLanesStepActive}"
                                    Visibility="{Binding ShowRoadLanesCard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Quante corsie ha la strada?'}" />
                                    <UniformGrid Columns="4">
                                        <UniformGrid.Resources>
                                            <Style x:Key="LaneCountButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="Margin" Value="0,0,6,0" />
                                                <Setter Property="Padding" Value="0,9" />
                                                <Setter Property="FontSize" Value="16" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Command" Value="{Binding DataContext.SetLaneCountCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRoadLanesStepActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Appearance" Value="Primary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Resources>
                                        <ui:Button Content="1" CommandParameter="1">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource LaneCountButton}">
                                                    <Style.Triggers>
                                                        <!-- Numero scelto: resta evidenziato in verde -->
                                                        <DataTrigger Binding="{Binding RoadLaneCount, Converter={StaticResource EnumEquals}, ConverterParameter=1}" Value="True">
                                                            <Setter Property="Appearance" Value="Success" />
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="#FF0B0E14" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Content="2" CommandParameter="2">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource LaneCountButton}">
                                                    <Style.Triggers>
                                                        <!-- Numero scelto: resta evidenziato in verde -->
                                                        <DataTrigger Binding="{Binding RoadLaneCount, Converter={StaticResource EnumEquals}, ConverterParameter=2}" Value="True">
                                                            <Setter Property="Appearance" Value="Success" />
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="#FF0B0E14" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Content="3" CommandParameter="3">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource LaneCountButton}">
                                                    <Style.Triggers>
                                                        <!-- Numero scelto: resta evidenziato in verde -->
                                                        <DataTrigger Binding="{Binding RoadLaneCount, Converter={StaticResource EnumEquals}, ConverterParameter=3}" Value="True">
                                                            <Setter Property="Appearance" Value="Success" />
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="#FF0B0E14" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Content="4" CommandParameter="4">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource LaneCountButton}">
                                                    <Style.Triggers>
                                                        <!-- Numero scelto: resta evidenziato in verde -->
                                                        <DataTrigger Binding="{Binding RoadLaneCount, Converter={StaticResource EnumEquals}, ConverterParameter=4}" Value="True">
                                                            <Setter Property="Appearance" Value="Success" />
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="#FF0B0E14" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding RoadSummary}"
                                               Visibility="{Binding RoadLanesChosen, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- 3. Linee tra le corsie -->
                            <Border Style="{StaticResource GuideCard}" Tag="{Binding IsRoadDividersStepActive}"
                                    Visibility="{Binding ShowRoadDividersCard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Linee tra le corsie'}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                               Text="{loc:Tr 'Porta ogni linea tratteggiata sulla separazione tra le corsie. Il pallino centrale sposta la linea intera.'}" />
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding RoadDividersHint}"
                                               Visibility="{Binding IsRoadDividersStepActive, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Content="{loc:Tr 'Le linee sono a posto'}" Icon="{ui:SymbolIcon Checkmark24}" HorizontalAlignment="Stretch" Padding="12,9"
                                               Command="{Binding ConfirmRoadDividersCommand}"
                                               Visibility="{Binding ShowConfirmRoadDividers, Converter={StaticResource BoolToVisibility}}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <ui:Button Content="{loc:Tr 'Ricomincia'}" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Transparent" HorizontalAlignment="Left" Margin="0,0,0,8"
                                       Command="{Binding ResetRoadCommand}" Visibility="{Binding HasRoad, Converter={StaticResource BoolToVisibility}}" />

                        </StackPanel>

                        <!-- Passo 3: analisi dei veicoli (prima della calibrazione) -->
                        <StackPanel Visibility="{Binding SelectedStep, Converter={StaticResource EnumToVisibility}, ConverterParameter=Analysis}">
                            <TextBlock Text="{loc:Tr 'Analisi veicoli'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                       Text="{loc:Tr 'Trova e segue i veicoli nel video. Le velocità arrivano con la calibrazione.'}" />

                            <!-- Avvio: verde finché l'analisi non è stata completata, poi l'azione principale è «Procedi» -->
                            <Grid Margin="0,0,0,12" Visibility="{Binding IsAnalyzing, Converter={StaticResource TruthyToVisibility}, ConverterParameter=Invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Content="{loc:Tr 'Analizza tutto'}" Icon="{ui:SymbolIcon Play24}" HorizontalAlignment="Stretch" Padding="12,10" Margin="0,0,4,0"
                                           Command="{Binding StartAnalysisCommand}" CommandParameter="all">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompletedAnalysis}" Value="True">
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Grid.Column="1" Content="{loc:Tr 'Dal fotogramma corrente'}" HorizontalAlignment="Stretch" Padding="8,10" Margin="4,0,0,0"
                                           Command="{Binding StartAnalysisCommand}" CommandParameter="current"
                                           ToolTip="{loc:Tr 'Analizza dal fotogramma mostrato nel video fino alla fine'}">
                                    <!-- Verde solo se il video non è sul primo fotogramma e l'analisi non è ancora stata fatta -->
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Secondary" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsBeyondFirstFrame}" Value="True" />
                                                        <Condition Binding="{Binding HasCompletedAnalysis}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <ui:Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </ui:Button.ContentTemplate>
                                </ui:Button>
                            </Grid>
                            <ui:Button Content="{loc:Tr 'Interrompi'}" Appearance="Danger" Icon="{ui:SymbolIcon Stop24}" HorizontalAlignment="Stretch" Padding="12,10" Margin="0,0,0,12"
                                       Command="{Binding StopAnalysisCommand}"
                                       Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />

                            <Border Style="{StaticResource Card}" Visibility="{Binding AnalysisStatusText, Converter={StaticResource TruthyToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding AnalysisStatusText}" Margin="0" />
                                    </Grid>
                                    <ProgressBar Margin="0,10,0,10" Height="6" Maximum="100" Value="{Binding AnalysisProgressValue}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding AnalysisSpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                    <!-- Contatori: veicoli tracciati, tracce scartate, fotogrammi fermi saltati -->
                                    <UniformGrid Columns="3" Margin="0,10,0,4" Visibility="{Binding HasAnalysisCounts, Converter={StaticResource BoolToVisibility}}">
                                        <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,4,0"
                                                ToolTip="{loc:Tr 'Veicoli tracciati fin qui: diventeranno passaggi misurati'}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="VehicleCar24" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding AnalysisVehiclesText}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0" Text="{Binding AnalysisVehiclesLabel}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="2,0"
                                                ToolTip="{loc:Tr 'Tracce troppo brevi o poco affidabili, non usate per la misura'}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="16" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding AnalysisRejectedText}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0" Text="{Binding AnalysisRejectedLabel}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,0,0,0"
                                                ToolTip="{loc:Tr 'Fotogrammi senza movimento: non serve cercarvi veicoli, si saltano per fare prima'}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Next24" FontSize="16" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding AnalysisSkippedText}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0" Text="{loc:Tr 'fotogrammi fermi saltati'}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding ExecutionProviderText}" />
                                </StackPanel>
                            </Border>

                            <!-- «Procedi» sotto il riquadro «Completata» -->
                            <ui:Button Content="{loc:Tr 'Procedi &gt;&gt;'}" Appearance="Primary" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Stretch" Padding="12,11" Margin="0,2,0,14"
                                       Command="{Binding GoToStepCommand}" CommandParameter="Calibration"
                                       Visibility="{Binding ShowAnalysisProceed, Converter={StaticResource BoolToVisibility}}" />


                            <Border Style="{StaticResource Card}" Visibility="{Binding BenchmarkText, Converter={StaticResource TruthyToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Prestazioni su questo PC'}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding BenchmarkText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Passo 5: misura manuale -->
                        <StackPanel Visibility="{Binding SelectedStep, Converter={StaticResource EnumToVisibility}, ConverterParameter=Measurement}">
                            <TextBlock Text="{loc:Tr 'Misura manuale'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource TextPrimary}" />

                            <Border Style="{StaticResource Notice}" Background="#142FCB79" BorderBrush="#442FCB79" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="8,0,0,0" MaxWidth="300" Foreground="{StaticResource TextPrimary}"
                                               Text="{loc:Tr 'Indica tu la posizione del veicolo, fotogramma per fotogramma: per correggere un passaggio o misurare un veicolo non riconosciuto.'}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0">
                                            <Run Text="{loc:Tr 'Veicolo'}" />
                                            <Run Text="{Binding CurrentVehicleId, Mode=OneWay, StringFormat='{}{0:0000}'}" FontFamily="{StaticResource MonoFont}" />
                                            <Run Text="{Binding EditingLabel, Mode=OneWay}" Foreground="{StaticResource WarnBrush}" FontWeight="Normal" FontSize="12" />
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}">
                                            <Run Text="{Binding CurrentPointCount, Mode=OneWay}" />
                                            <Run Text="{loc:Tr 'punti'}" />
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Style="{StaticResource Body}" Text="{Binding MeasurementHint}" Margin="0,0,0,14" Foreground="{StaticResource TextSecondary}" />

                                    <!-- Stato delle due linee -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource LineABrush}" VerticalAlignment="Top">
                                            <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,2,0,0" Style="{StaticResource Body}" Text="{Binding CrossingAStatus}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource LineBBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="10,2,0,0" Style="{StaticResource Body}" Text="{Binding CrossingBStatus}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                    </Grid>

                                    <!-- Velocità -->
                                    <Border Background="#18000000" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding CurrentSpeedText, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                                <Run Text="km/h" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CurrentResultText}" Visibility="{Binding CurrentResultText, Converter={StaticResource TruthyToVisibility}}" />
                                        </StackPanel>
                                    </Border>

                                    <ui:Button Content="{loc:Tr 'Salva passaggio'}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                                               HorizontalAlignment="Stretch" Padding="12,10" Margin="0,0,0,8"
                                               Command="{Binding SavePassageCommand}" ToolTip="{loc:Tr 'Invio'}" />
                                    <UniformGrid Columns="2">
                                        <ui:Button Content="{loc:Tr 'Annulla punto'}" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoPointCommand}"
                                                   HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip="{loc:Tr 'Ctrl+Z'}" />
                                        <ui:Button Content="{loc:Tr 'Nuovo veicolo'}" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewVehicleCommand}"
                                                   HorizontalAlignment="Stretch" Margin="4,0,0,0" ToolTip="{loc:Tr 'Scarta i punti del veicolo corrente'}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <ui:ToggleSwitch IsChecked="{Binding AutoAdvance}" Content="{loc:Tr 'Avanza dopo ogni clic'}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding AutoAdvance}">
                                        <TextBlock Text="{loc:Tr 'di'}" Style="{StaticResource Label}" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding AutoAdvanceOptions}" SelectedItem="{Binding AutoAdvanceFrames}" MinWidth="90" />
                                        <TextBlock Text="{loc:Tr 'fotogrammi'}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Come misurare'}" />
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6" Text="{loc:Tr '1. Scegli un punto del veicolo, per esempio dove la ruota anteriore tocca l\'asfalto.'}" />
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6" Text="{loc:Tr '2. Cliccalo in 2–3 fotogrammi prima e dopo ogni linea.'}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr 'Tasti: ← → fotogramma · Maiusc ±10 · Spazio riproduci · Ctrl+Z annulla · Invio salva · rotellina zoom'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Passo 6: risultati -->
                        <StackPanel Visibility="{Binding SelectedStep, Converter={StaticResource EnumToVisibility}, ConverterParameter=Results}">
                            <TextBlock Text="{loc:Tr 'Risultati'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="{StaticResource TextPrimary}" />

                            <!-- Filtro: chiuso all'inizio; il titolo dice se è attivo -->
                            <ui:CardExpander Header="{Binding FilterHeaderText}" Icon="{ui:SymbolIcon Filter24}" IsExpanded="False" Margin="0,0,0,8"
                                             Visibility="{Binding HasAnyPassage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <ui:Button HorizontalAlignment="Right" Content="{loc:Tr 'Mostra tutti'}" Appearance="Transparent" Padding="8,3" FontSize="12" Margin="0,0,0,6"
                                               Command="{Binding ResetFilterCommand}"
                                               Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="{loc:Tr 'Velocità superiore a'}" Margin="0,0,10,0" />
                                        <ui:TextBox Grid.Column="1" Text="{Binding MinSpeedFilterText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'tutte'}"
                                                    ClearButtonEnabled="False" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="km/h" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                                               Text="{Binding MinSpeedFilterError}" Visibility="{Binding MinSpeedFilterError, Converter={StaticResource TruthyToVisibility}}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox Content="{loc:Tr 'Auto'}" IsChecked="{Binding ShowCars}" Margin="0,0,14,4" MinWidth="0" />
                                        <CheckBox Content="{loc:Tr 'Moto'}" IsChecked="{Binding ShowMotorcycles}" Margin="0,0,14,4" MinWidth="0" />
                                        <CheckBox Content="{loc:Tr 'Autobus'}" IsChecked="{Binding ShowBuses}" Margin="0,0,14,4" MinWidth="0" />
                                        <CheckBox Content="{loc:Tr 'Camion'}" IsChecked="{Binding ShowTrucks}" Margin="0,0,14,4" MinWidth="0" />
                                        <CheckBox Content="{loc:Tr 'Misure manuali'}" IsChecked="{Binding ShowManual}" Margin="0,0,14,4" MinWidth="0" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Label}" Text="{loc:Tr 'Verso'}" Margin="0,0,12,4" />
                                        <CheckBox Content="A → B" IsChecked="{Binding ShowAToB}" Margin="0,0,14,4" MinWidth="0" />
                                        <CheckBox Content="B → A" IsChecked="{Binding ShowBToA}" Margin="0,0,14,4" MinWidth="0" />
                                    </WrapPanel>
                                    <!-- Punto di misura delle misure automatiche: ruota anteriore (icona della ruota nell'elenco) o spigolo del riquadro -->
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Label}" Text="{loc:Tr 'Punto di misura'}" Margin="0,0,12,4" />
                                        <CheckBox IsChecked="{Binding ShowWheelReference}" Margin="0,0,14,4" MinWidth="0"
                                                  ToolTip="{loc:Tr 'Misure automatiche fatte dove la ruota anteriore tocca l\'asfalto'}">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Template="{StaticResource WheelIcon}" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Tr 'Ruota anteriore'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Content="{loc:Tr 'Spigolo del riquadro'}" IsChecked="{Binding ShowBoxReference}" Margin="0,0,14,4" MinWidth="0"
                                                  ToolTip="{loc:Tr 'Misure automatiche fatte sullo spigolo del riquadro, quando la ruota non è stata trovata con sicurezza'}" />
                                    </WrapPanel>
                                    <DockPanel Margin="0,6,0,0" Visibility="{Binding ShowLaneFilter, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{loc:Tr 'Corsia'}" Margin="0,0,12,4" VerticalAlignment="Top" />
                                        <ItemsControl ItemsSource="{Binding LaneFilters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LaneFilterOption}">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsShown}" Margin="0,0,14,4" MinWidth="0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Text="{loc:Tr 'Statistiche ed esportazione usano solo i passaggi mostrati.'}" />
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- Limite di velocità: chi lo supera è in rosso nel grafico e nell'elenco -->
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8"
                                    Visibility="{Binding HasAnyPassage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Limite di velocità'}" Margin="0" VerticalAlignment="Center" />
                                        <ui:TextBox Grid.Column="1" Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="km/h" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                                               Text="{Binding SpeedLimitError}" Visibility="{Binding SpeedLimitError, Converter={StaticResource TruthyToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr 'Media'}" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MeanSpeedText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="km/h" Style="{StaticResource Label}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="3,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr 'Minima'}" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MinSpeedText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="km/h" Style="{StaticResource Label}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="3,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr 'Massima'}" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding MaxSpeedText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="km/h" Style="{StaticResource Label}" />
                                    </StackPanel>
                                </Border>
                                <!-- Veicoli oltre il limite (tra quelli mostrati dal filtro) -->
                                <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr 'Multe'}" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding FinesText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFines}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{loc:Tr 'veicoli'}" Style="{StaticResource Label}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Grafico: passaggi per fascia di velocità (0–100 km/h a scaglioni di 5) -->
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
                                    Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Distribuzione delle velocità'}" Margin="0" VerticalAlignment="Center" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding HistogramMaxText}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,1" Padding="2,0,0,0">
                                        <ItemsControl ItemsSource="{Binding SpeedHistogram}" Height="130">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HistogramBin}">
                                                    <StackPanel VerticalAlignment="Bottom" Margin="1,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                                                        <TextBlock Text="{Binding CountText}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                                        <Border Height="{Binding BarHeight}" CornerRadius="2,2,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <!-- Fasce sopra il limite di velocità -->
                                                                        <DataTrigger Binding="{Binding OverLimit}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <!-- Asse delle velocità: limite inferiore di ogni fascia (uno sì e uno no) -->
                                    <ItemsControl ItemsSource="{Binding SpeedHistogram}" Margin="3,3,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HistogramBin}">
                                                <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Left" Foreground="{StaticResource TextTertiary}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" Text="{loc:Tr 'Velocità (km/h) · numero di passaggi per fascia di 5 km/h'}" />
                                </StackPanel>
                            </Border>

                            <ui:Button Content="{Binding ExportButtonText}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                                       HorizontalAlignment="Stretch" Padding="12,10" Margin="0,0,0,8"
                                       Command="{Binding ExportResultsCommand}" />
                            <ui:Button Content="{loc:Tr 'Apri la cartella esportata'}" Icon="{ui:SymbolIcon Folder24}"
                                       HorizontalAlignment="Stretch" Command="{Binding OpenExportFolderCommand}" />

                            <!-- Tre linguette, con un'icona e il numero (il nome nel suggerimento): auto verde con la V = corretti, auto rossa
                                 con la matita = da correggere, auto grigia con il cestino = scartati.
                                 Passaggi corretti (statistiche, grafico, esportazione e PDF), da correggere
                                 (ruota anteriore non seguita bene vicino alle linee, o tolti dai corretti) e scartati (senza un
                                 passaggio valido tra le linee, o eliminati da «Da correggere») -->
                            <Grid Margin="0,14,0,10" Visibility="{Binding HasAnyPassage, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="6,8" Margin="0,0,3,0" Command="{Binding ShowValidTabCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValidTab}" Value="True">
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding ValidTabText}">
                                        <Grid Width="33" Height="26" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="VehicleCar24" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="17" Height="17" CornerRadius="9" Background="{StaticResource AccentBrush}" BorderBrush="#FF1B1F26" BorderThickness="1.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Passages.Count}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="6,8" Margin="3,0,3,0" Command="{Binding ShowReviewTabCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReviewTab}" Value="True">
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding ReviewTabText}">
                                        <Grid Width="33" Height="26" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="VehicleCar24" FontSize="24" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="17" Height="17" CornerRadius="9" Background="{StaticResource ErrorBrush}" BorderBrush="#FF1B1F26" BorderThickness="1.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ReviewPassages.Count}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="6,8" Margin="3,0,0,0" Command="{Binding ShowDiscardedTabCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiscardedTab}" Value="True">
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding DiscardedTabText}">
                                        <Grid Width="33" Height="26" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="VehicleCar24" FontSize="24" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Width="17" Height="17" CornerRadius="9" Background="{StaticResource TextTertiary}" BorderBrush="#FF1B1F26" BorderThickness="1.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding DiscardedPassages.Count}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,10" TextWrapping="Wrap"
                                       Visibility="{Binding ShowTabCaption, Converter={StaticResource BoolToVisibility}}" Text="{Binding TabCaption}" />
                            <DockPanel Margin="2,0,0,8">
                                <!-- Ordine dell'elenco: orologio = orario, tachimetro = velocità; la freccia in giù indica valori che crescono
                                     scendendo nell'elenco (primo → ultimo, velocità crescente), quella in su il contrario -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding ShowSortButtons, Converter={StaticResource BoolToVisibility}}">
                                    <RadioButton GroupName="PassageSort" Style="{StaticResource SortButton}" IsChecked="{Binding IsSortFirstToLast}"
                                                 ToolTip="{loc:Tr 'Dal primo all\'ultimo'}" AutomationProperties.Name="{loc:Tr 'Dal primo all\'ultimo'}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Clock20" FontSize="14" />
                                            <ui:SymbolIcon Symbol="ArrowDown20" FontSize="12" Margin="1,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PassageSort" Style="{StaticResource SortButton}" IsChecked="{Binding IsSortLastToFirst}"
                                                 ToolTip="{loc:Tr 'Dall\'ultimo al primo'}" AutomationProperties.Name="{loc:Tr 'Dall\'ultimo al primo'}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Clock20" FontSize="14" />
                                            <ui:SymbolIcon Symbol="ArrowUp20" FontSize="12" Margin="1,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PassageSort" Style="{StaticResource SortButton}" IsChecked="{Binding IsSortSpeedAscending}" Margin="10,0,0,0"
                                                 ToolTip="{loc:Tr 'Velocità crescente'}" AutomationProperties.Name="{loc:Tr 'Velocità crescente'}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="TopSpeed20" FontSize="14" />
                                            <ui:SymbolIcon Symbol="ArrowDown20" FontSize="12" Margin="1,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PassageSort" Style="{StaticResource SortButton}" IsChecked="{Binding IsSortSpeedDescending}"
                                                 ToolTip="{loc:Tr 'Velocità decrescente'}" AutomationProperties.Name="{loc:Tr 'Velocità decrescente'}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="TopSpeed20" FontSize="14" />
                                            <ui:SymbolIcon Symbol="ArrowUp20" FontSize="12" Margin="1,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <TextBlock Text="{Binding PassageCountText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                       Visibility="{Binding ShowNoPassageHint, Converter={StaticResource BoolToVisibility}}"
                                       Text="{loc:Tr 'Nessun veicolo attraversa le linee A e B. Esegui l\'analisi e la calibrazione, oppure misura un veicolo a mano.'}" />

                            <ListBox ItemsSource="{Binding ShownPassages}" SelectedItem="{Binding SelectedPassage}"
                                     ItemContainerStyle="{StaticResource ResultItem}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="0,0,0,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PassageRow}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center">
                                                        <Run Text="{Binding IdText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding DirectionText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                                                        <Run Text="{Binding LaneText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                                    </TextBlock>
                                                    <!-- Velocità misurata sulla ruota anteriore -->
                                                    <ContentControl Template="{StaticResource WheelIcon}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    ToolTip="{loc:Tr 'Velocità misurata dove la ruota anteriore tocca l\'asfalto'}"
                                                                    Visibility="{Binding IsWheelReference, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0">
                                                    <Run Text="{Binding EntryText, Mode=OneWay}" />
                                                    <Run Text="→" />
                                                    <Run Text="{Binding ExitText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0">
                                                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding MethodText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" Text="{Binding SourceText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}">
                                                    <Run Text="{Binding SpeedText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                                                    <Run Text="km/h" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right" Text="{Binding UncertaintyText}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" />
                                            </StackPanel>

                                            <!-- Azioni: solo sull'auto selezionata; in modifica «Annulla modifica» e «Salva modifica» -->
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                                        Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}">
                                            <WrapPanel Visibility="{Binding DataContext.IsEditingPassage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TruthyToVisibility}, ConverterParameter=Invert}">
                                                <WrapPanel.Resources>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Margin" Value="0,0,6,6" />
                                                        <Setter Property="Padding" Value="10,5" />
                                                        <Setter Property="FontSize" Value="12.5" />
                                                    </Style>
                                                </WrapPanel.Resources>
                                                <ui:Button Content="{loc:Tr 'Ingresso'}" Command="{Binding DataContext.ShowEntryFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{loc:Tr 'Mostra il fotogramma di ingresso'}" />
                                                <ui:Button Content="{loc:Tr 'Uscita'}" Command="{Binding DataContext.ShowExitFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{loc:Tr 'Mostra il fotogramma di uscita'}" />
                                                <ui:Button Content="{loc:Tr 'Modifica'}" Icon="{ui:SymbolIcon Edit24}" Command="{Binding DataContext.EditPassageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <ui:Button Content="{loc:Tr 'Sposta in passaggi validi'}" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                                           Command="{Binding DataContext.MoveToValidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Visibility="{Binding DataContext.IsNotValidTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- Nessun veicolo si cancella: nei corretti «Da correggere» lo sposta tra quelli da correggere,
                                                     nei da correggere «Elimina» lo sposta tra gli scartati -->
                                                <ui:Button Content="{loc:Tr 'Da correggere'}" Icon="{ui:SymbolIcon Warning24}" Command="{Binding DataContext.DeletePassageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           ToolTip="{Binding DataContext.DeleteTooltip, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Visibility="{Binding DataContext.IsValidTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:Button Content="{loc:Tr 'Elimina'}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DataContext.DeletePassageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           ToolTip="{Binding DataContext.DeleteTooltip, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Visibility="{Binding DataContext.IsReviewTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                            </WrapPanel>
                                            <StackPanel Visibility="{Binding DataContext.IsEditingPassage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Text="{Binding DataContext.EditHintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <WrapPanel>
                                                    <WrapPanel.Resources>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                            <Setter Property="Margin" Value="0,0,6,6" />
                                                            <Setter Property="Padding" Value="10,5" />
                                                            <Setter Property="FontSize" Value="12.5" />
                                                        </Style>
                                                    </WrapPanel.Resources>
                                                    <ui:Button Content="{loc:Tr 'Annulla modifica'}" Icon="{ui:SymbolIcon ArrowUndo24}"
                                                               Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ui:Button Content="{loc:Tr 'Salva modifica'}" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                                                               Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
