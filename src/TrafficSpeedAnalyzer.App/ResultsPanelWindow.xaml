<ui:FluentWindow x:Class="TrafficSpeedAnalyzer.App.ResultsPanelWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:TrafficSpeedAnalyzer.App.Localization"
                 xmlns:vm="clr-namespace:TrafficSpeedAnalyzer.App.ViewModels;assembly=TrafficSpeedAnalyzer.Presentation"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title=""
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="460" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <!--
      Finestra dei risultati per filtro, limite di velocità o statistiche (uno alla volta, scelto all'apertura).
      DataContext = MainViewModel: le modifiche valgono subito per l'elenco dei passaggi.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="WindowTitle" Grid.Row="0" ShowMinimize="False" ShowMaximize="False" />
        <ScrollViewer Grid.Row="1" MaxHeight="820" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,8,20,20">
                <!-- Filtro; il titolo dice se è attivo -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Filter24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding FilterHeaderText}" Margin="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel>
                            <ui:Button HorizontalAlignment="Right" Content="{loc:Tr 'Mostra tutti'}" Appearance="Transparent" Padding="8,3" FontSize="12" Margin="0,0,0,6"
                                       Command="{Binding ResetFilterCommand}"
                                       Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="{loc:Tr 'Velocità superiore a'}" Margin="0,0,10,0" />
                                <ui:TextBox Grid.Column="1" Text="{Binding MinSpeedFilterText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'tutte'}"
                                            ClearButtonEnabled="False" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="km/h" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                                       Text="{Binding MinSpeedFilterError}" Visibility="{Binding MinSpeedFilterError, Converter={StaticResource TruthyToVisibility}}" />
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox Content="{loc:Tr 'Auto'}" IsChecked="{Binding ShowCars}" Margin="0,0,14,4" MinWidth="0" />
                                <CheckBox Content="{loc:Tr 'Moto'}" IsChecked="{Binding ShowMotorcycles}" Margin="0,0,14,4" MinWidth="0" />
                                <CheckBox Content="{loc:Tr 'Autobus'}" IsChecked="{Binding ShowBuses}" Margin="0,0,14,4" MinWidth="0" />
                                <CheckBox Content="{loc:Tr 'Camion'}" IsChecked="{Binding ShowTrucks}" Margin="0,0,14,4" MinWidth="0" />
                                <CheckBox Content="{loc:Tr 'Misure manuali'}" IsChecked="{Binding ShowManual}" Margin="0,0,14,4" MinWidth="0" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Label}" Text="{loc:Tr 'Verso'}" Margin="0,0,12,4" />
                                <CheckBox Content="A → B" IsChecked="{Binding ShowAToB}" Margin="0,0,14,4" MinWidth="0" />
                                <CheckBox Content="B → A" IsChecked="{Binding ShowBToA}" Margin="0,0,14,4" MinWidth="0" />
                            </WrapPanel>
                            <!-- Punto di misura delle misure automatiche: ruota anteriore (icona della ruota nell'elenco) o spigolo del riquadro -->
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Label}" Text="{loc:Tr 'Punto di misura'}" Margin="0,0,12,4" />
                                <CheckBox IsChecked="{Binding ShowWheelReference}" Margin="0,0,14,4" MinWidth="0"
                                          ToolTip="{loc:Tr 'Misure automatiche fatte dove la ruota anteriore tocca l\'asfalto'}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Template="{StaticResource WheelIcon}" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Tr 'Ruota anteriore'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Content="{loc:Tr 'Spigolo del riquadro'}" IsChecked="{Binding ShowBoxReference}" Margin="0,0,14,4" MinWidth="0"
                                          ToolTip="{loc:Tr 'Misure automatiche fatte sullo spigolo del riquadro, quando la ruota non è stata trovata con sicurezza'}" />
                            </WrapPanel>
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding ShowLaneFilter, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{loc:Tr 'Corsia'}" Margin="0,0,12,4" VerticalAlignment="Top" />
                                <ItemsControl ItemsSource="{Binding LaneFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LaneFilterOption}">
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsShown}" Margin="0,0,14,4" MinWidth="0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="{loc:Tr 'Statistiche ed esportazione usano solo i passaggi mostrati.'}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Limite di velocità: chi lo supera è in rosso nel grafico e nell'elenco -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8"
                        Visibility="{Binding IsLimitPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Limite di velocità'}" Margin="0" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Column="1" Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="km/h" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                                   Text="{Binding SpeedLimitError}" Visibility="{Binding SpeedLimitError, Converter={StaticResource TruthyToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Statistiche: media, minima, massima, multe e grafico -->
                <StackPanel Visibility="{Binding IsStatsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Media'}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding MeanSpeedText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="km/h" Style="{StaticResource Label}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="3,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Minima'}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding MinSpeedText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="km/h" Style="{StaticResource Label}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="3,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Massima'}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding MaxSpeedText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="km/h" Style="{StaticResource Label}" />
                            </StackPanel>
                        </Border>
                        <!-- Veicoli oltre il limite (tra quelli mostrati dal filtro) -->
                        <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Multe'}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding FinesText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFines}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{loc:Tr 'veicoli'}" Style="{StaticResource Label}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Grafico: passaggi per fascia di velocità (0–100 km/h a scaglioni di 5) -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
                            Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 'Distribuzione delle velocità'}" Margin="0" VerticalAlignment="Center" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding HistogramMaxText}" />
                            </Grid>
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,1" Padding="2,0,0,0">
                                <ItemsControl ItemsSource="{Binding SpeedHistogram}" Height="130">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HistogramBin}">
                                            <StackPanel VerticalAlignment="Bottom" Margin="1,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                                                <TextBlock Text="{Binding CountText}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                                <Border Height="{Binding BarHeight}" CornerRadius="2,2,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <!-- Fasce sopra il limite di velocità -->
                                                                <DataTrigger Binding="{Binding OverLimit}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <!-- Asse delle velocità: limite inferiore di ogni fascia (uno sì e uno no) -->
                            <ItemsControl ItemsSource="{Binding SpeedHistogram}" Margin="3,3,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HistogramBin}">
                                        <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Left" Foreground="{StaticResource TextTertiary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" Text="{loc:Tr 'Velocità (km/h) · numero di passaggi per fascia di 5 km/h'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ui:Button Content="{loc:Tr 'Chiudi'}" Appearance="Primary" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="20,8"
                           IsDefault="True" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
