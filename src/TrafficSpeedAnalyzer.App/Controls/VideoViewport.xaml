<UserControl x:Class="TrafficSpeedAnalyzer.App.Controls.VideoViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:TrafficSpeedAnalyzer.App.Localization"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
    <Grid x:Name="Root" ClipToBounds="True" Background="#FF0A0D12">
        <Viewbox x:Name="FitBox" Stretch="Uniform" RenderTransformOrigin="0,0">
            <Grid x:Name="Surface">
                <Image x:Name="FrameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False" />
                <Canvas x:Name="Overlay" Background="Transparent" IsHitTestVisible="False" />
            </Grid>
        </Viewbox>

        <!-- Indicatore di zoom -->
        <Border x:Name="ZoomBadge"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Padding="10,4" CornerRadius="6" Background="#B0101418"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ZoomText" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="ResetZoomButton" Content="{loc:Tr 'Adatta'}" Margin="10,0,0,0" Padding="8,2" FontSize="12"
                        Click="OnResetZoomClick" Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Suggerimento della modalità corrente -->
        <Border x:Name="HintBadge"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                Padding="14,7" CornerRadius="8" Background="#D0101418"
                BorderBrush="#40FFFFFF" BorderThickness="1"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="640" />
        </Border>
    </Grid>
</UserControl>
