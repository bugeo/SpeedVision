<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Rilevamento veicoli con ONNX Runtime (DirectML su Windows, CoreML su Mac, con ripiego automatico su CPU),
    tracking e pipeline di analisi automatica. Modelli YOLOX (Apache-2.0) scaricati su richiesta.
  -->
  <PropertyGroup>
    <TargetFramework>$(TsaTargetFramework)</TargetFramework>
    <RootNamespace>TrafficSpeedAnalyzer.Detection</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <!--
    ONNX Runtime (licenza MIT, include l'esecutore CPU). Su Windows il pacchetto con DirectML;
    altrove quello generico, che per Mac (osx-arm64) contiene CoreML e per Linux la sola CPU.
    I due pacchetti hanno le stesse API: cambia solo la libreria nativa.
    Si può forzare con -p:TsaOnnxRuntimePackage=...
  -->
  <PropertyGroup>
    <TsaOnnxRuntimePackage Condition="'$(TsaOnnxRuntimePackage)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Microsoft.ML.OnnxRuntime.DirectML</TsaOnnxRuntimePackage>
    <TsaOnnxRuntimePackage Condition="'$(TsaOnnxRuntimePackage)' == ''">Microsoft.ML.OnnxRuntime</TsaOnnxRuntimePackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(TsaOnnxRuntimePackage)" Version="1.24.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TrafficSpeedAnalyzer.Core\TrafficSpeedAnalyzer.Core.csproj" />
    <ProjectReference Include="..\TrafficSpeedAnalyzer.Video\TrafficSpeedAnalyzer.Video.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TrafficSpeedAnalyzer.Detection.Tests" />
  </ItemGroup>
</Project>
